{
  "info": {
    "_postman_id": "7d32c3ab-e998-40a9-bee6-5e2a985550a0",
    "name": "HRMS Auth API",
    "description": "Registration, Verify OTP, Login, Forgot Password, Reset Password, Change Password. Import the matching environment (HRMS-Auth.postman_environment.json) alongside this collection. Run order: Register -> (set {{otp}} from email) -> Verify OTP -> Login -> [Change Password any time after this, while logged in] -> Forgot Password -> (copy the token from the emailed reset link into {{resetToken}}) -> Reset Password (not logged in).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('userId', body.user.id);",
              "}",
              "// Account is created unverified — no token yet. An OTP (purpose: verify-account) is",
              "// emailed. Check your email/SMTP logs, set {{otp}}, then run 'Verify OTP'."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('token', body.token);",
              "  pm.environment.set('userId', body.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "verify-otp"]
        }
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.environment.set('token', body.token);",
              "  pm.environment.set('userId', body.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "Forgot Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.code === 200);",
              "// No OTP for this flow. A reset LINK is emailed instead:",
              "// {{FRONTEND_URL}}/resetpassword.html?token=<resetToken>&email=<email>",
              "// Check your email/SMTP logs, copy the 'token' query param value, and set it",
              "// as the {{resetToken}} environment variable before running 'Reset Password'."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "forgot-password"]
        }
      },
      "response": []
    },
    {
      "name": "Reset Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.code === 200);",
              "// Not logged in — authenticated via {{resetToken}} copied from the emailed reset link.",
              "// Used by the forgot-password flow. No Authorization header."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "reset-password"]
        }
      },
      "response": []
    },
    {
      "name": "Change Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.code === 200);",
              "// Logged in — authenticated via the Bearer {{token}} saved by Login/Verify OTP.",
              "// Also requires {{password}} as oldPassword (the account's current password).",
              "// No email or resetToken needed or accepted."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/change-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "change-password"]
        }
      },
      "response": []
    }
  ]
}
